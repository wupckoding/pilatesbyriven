# Build do app do iPhone: `npm run build:ios`. Valores públicos (vão dentro do app).
VITE_API_URL=https://app.pilatesbyriven.com
# ID de cliente OAuth do Google do tipo "iOS" (Google Cloud Console). Vazio = sem botão do Google no app.
VITE_GOOGLE_IOS_CLIENT_ID=
# ID de cliente OAuth do Google do tipo "Web" (o mesmo GOOGLE_CLIENT_ID do servidor).
VITE_GOOGLE_WEB_CLIENT_ID=

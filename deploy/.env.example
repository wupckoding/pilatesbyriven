# Copie para /opt/pilates/.env na VPS (chmod 600) e preencha. Este arquivo nunca vai para o git.
# "./gen-secrets.sh" imprime valores novos para as quatro chaves abaixo.

# Domínio do app, sem https:// (o DNS precisa apontar para a VPS antes de subir).
DOMAIN=app.pilatesbyriven.com

# Senha do banco. Use só letras e números (ela entra em uma URL).
DB_PASSWORD=

# Assina as sessões de login. Trocar este valor desconecta todo mundo.
JWT_SECRET=

# Chave que cifra as respostas clínicas. GUARDE UMA CÓPIA FORA DA VPS:
# sem ela, as respostas já gravadas não podem mais ser lidas — nem com o backup do banco.
INTAKE_KEY=

# Conta de administração criada na primeira vez (./compose.sh exec app node src/seed.js).
# Senha com 12+ caracteres, só letras, números, "-" e "_". Depois de entrar, troque-a no app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Riven

# E-mail de saída: envia o código de 6 dígitos que confirma o e-mail no cadastro.
# Enquanto SMTP_HOST estiver vazio, o cadastro NÃO exige confirmação.
# Caixa da Hostinger: smtp.hostinger.com, porta 465, usuário = o e-mail completo.
# Coloque a senha entre aspas simples (ela pode ter $ ou #).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=''
MAIL_FROM='Pilates by Riven <contacto@pilatesbyriven.com>'

# Entrar com Google: ID de cliente OAuth "Aplicativo da Web" criado em console.cloud.google.com
# (origem JavaScript autorizada: https://SEU-DOMINIO). É público, não é segredo. Vazio = sem botão.
GOOGLE_CLIENT_ID=

# Backups (opcional)
# BACKUP_DIR=/var/backups/pilates
# KEEP_DAYS=14

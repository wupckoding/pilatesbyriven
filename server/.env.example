NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/pilates
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Origem do front (separe várias por vírgula)
CORS_ORIGIN=https://app.pilatesbyriven.com
# Conta admin inicial criada pelo "npm run seed"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Riven

# Llave de cifrado de las respuestas clínicas (32 bytes en base64). Guárdala también fuera del servidor:
# si se pierde, las respuestas guardadas no se pueden leer.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTAKE_KEY=
# Carpeta privada para comprobantes (fuera de la carpeta pública)
# UPLOADS_DIR=/var/lib/pilates/uploads

# Correo saliente: envía el código de 6 dígitos que confirma el correo al registrarse.
# Sin SMTP_HOST no se exige confirmar. En desarrollo, MAIL_CAPTURE=1 imprime los correos en la consola.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contacto@pilatesbyriven.com
# SMTP_PASS=
# MAIL_FROM=Pilates by Riven <contacto@pilatesbyriven.com>
# MAIL_CAPTURE=1

# Acceso con Google (ID de cliente OAuth tipo "Aplicación web"; es público). Vacío = sin botón.
# GOOGLE_CLIENT_ID=
# App de iPhone: ID de cliente iOS del Google y llave de Apple (ver docs/APP_STORE.md)
# GOOGLE_IOS_CLIENT_ID=
# APPLE_CLIENT_IDS=com.pilatesbyriven.app
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
